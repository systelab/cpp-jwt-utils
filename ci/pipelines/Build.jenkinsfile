def version = "0.0.0"
def profile = "vs2022.conanprofile"
def archs = ['x86', 'x86_64']
def configs = ['Debug', 'Release']

@Library('aid-pipeline-utils@1.0.23') _

pipeline
{
	agent
	{
		label 'shared-lib-build'
	}

	environment
	{
		PATH = "${env.USERPROFILE}\\.venvs\\conan2\\Scripts;${env.PATH}"
	}

	parameters
	{
		string(	name: 'version',
				description: 'Version to build (must match the name of the tag that will be checked out), leave blank for checkout of current branch',
				defaultValue: '' )

		booleanParam( name: 'uploadPackage',
					  description: 'Whether or not to upload testing conan package',
					  defaultValue: false )
	}

	options
	{
		skipDefaultCheckout(true)
		disableConcurrentBuilds()
		buildDiscarder(logRotator(numToKeepStr: '5'))
	}

	stages
	{
		stage('Checkout')
		{
			steps
			{
				deleteDir()
				script 
				{
					if (params.version == '')
					{
						checkoutSourceCode()
					}
					else
					{
						checkoutSourceCodeFromTag(version)
						version = params.version
					}
				}
			}
		}
		
		stage('Build packages')
		{
			steps
			{
				script
				{
					archs.each
					{ arch ->
						configs.each
						{ config ->
							stage("Package ${config}|${arch}")
							{
								def buildFolder = "build/${config}-${arch}"
								def conanArgs = "--profile:all=${profile} --settings:all arch=${arch} --settings:all build_type=${config}"
								
								bat "conan build . --output-folder ${buildFolder} ${conanArgs}"
								bat "conan export-pkg . --version=${version} --output-folder ${buildFolder} ${conanArgs}"
								bat "conan test test_package jwt-utils/${version} ${conanArgs}"
								
								bat "conan create test/JWTUtilsTestUtilities --version=${version} ${conanArgs}"
							}
						}
					}
				}
			}
		}

		stage('Unit tests')
		{
			steps
			{
				script
				{
					archs.each
					{ arch ->
						configs.each
						{ config ->
							stage("Test ${config}|${arch}")
							{
								dir("build/${config}-${arch}/bin/${config}/")
								{
									bat "JWTUtilsTest.exe --gtest_output=xml:JWTUtilsTest.xml"
								}
							}
						}
					}
				}
			}
		}

		stage('Deploy')
		{
			when
			{
				expression { params.uploadPackage }
			}
			steps
			{
				bat "conan upload jwt-utils/${version} --remote aid-conan-production-local --confirm --force"
				bat "conan upload jwt-utils-test-utilities/${version} --remote aid-conan-production-local --confirm --force"
			}
		}	
	}
	
	post
	{
		always
		{
			junit allowEmptyResults: true, testResults: "build/**/JWTUtilsTest.xml"
			script
			{
				currentBuild.description = "${version}"
			}
		}
	}
}